# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Chave pública da MESMA aplicação do token. Com ela o pagamento acontece dentro
# do site (Checkout Bricks); vazia, o site volta ao Checkout Pro (redireciona ao
# Mercado Pago). Teste e produção têm chaves diferentes (TEST-… e APP_USR-…).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Rastreamento de conversões (cada plataforma só liga se tiver os seus valores).
# Meta: ID do Pixel (público) e token da API de Conversões (segredo, só servidor).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Opcional: código do "Testar eventos" do Gerenciador de Eventos (remover em produção).
META_TEST_EVENT_CODE=
# Google Analytics 4: ID de medição (G-…) e segredo da API de Measurement Protocol.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Google Ads: ID da conta (AW-…) e rótulo da conversão de compra.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# IA (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# E-mail (Resend)
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Carta Celeste <contato@seudominio.com.br>
# Vazio = remetente de testes do Resend (só entrega ao dono da conta Resend)
RESEND_FROM_EMAIL=

# Protege /api/jobs/generate-report
JOB_SECRET=

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=

# E-mail do usuário admin criado pelo seed
ADMIN_EMAIL=

# Exige verificação em dois passos (aplicativo autenticador) no /admin.
# Valor "true" liga. Antes de ligar, o admin cadastra o aplicativo em
# /conta/seguranca; ligar antes tranca o admin do lado de fora.
ADMIN_REQUIRE_MFA=

# Limpeza diária (Vercel Cron, 06:00 UTC). A Vercel chama /api/cron/limpeza com
# "Authorization: Bearer <CRON_SECRET>"; sem o segredo a rota recusa tudo.
# Use um valor aleatório longo (mínimo 16 caracteres).
CRON_SECRET=
# Dias para apagar contas criadas e nunca confirmadas (1 a 365). Vazio = a
# limpeza fica desligada. Decisão do negócio; mencionar na Política de Privacidade.
UNCONFIRMED_ACCOUNT_TTL_DAYS=
